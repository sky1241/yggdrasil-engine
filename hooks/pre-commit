#!/usr/bin/env python3
"""
WINTER TREE — Hook pre-commit Yggdrasil Engine.

Avant chaque commit, met a jour automatiquement:
  1. .winter-tree-stats.json  — stats cross-projets
  2. data/topology/winter-tree.json — architecture projet (stats + date)
  3. docs/CHANGELOG.md — date de derniere maj
  4. docs/TODO.md — date de derniere maj
  5. docs/SOL.md — date dans le header

Leger, rapide, pas de dependances externes.
"""
import json
import os
import re
import subprocess
from pathlib import Path
from datetime import datetime

ROOT = Path(__file__).resolve().parent.parent.parent  # .git/hooks/pre-commit -> .git/hooks -> .git -> repo root
STATS_FILE = ROOT / ".winter-tree-stats.json"
TREE_FILE = ROOT / "data" / "topology" / "winter-tree.json"
CHANGELOG = ROOT / "docs" / "CHANGELOG.md"
TODO_FILE = ROOT / "docs" / "TODO.md"
SOL_FILE = ROOT / "docs" / "SOL.md"

TODAY = datetime.now().strftime("%Y-%m-%d")
TODAY_FR = f"{int(TODAY[8:10])} {['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'][int(TODAY[5:7])-1]} {TODAY[:4]}"

# Extensions code -> langage
EXT_LANG = {
    ".py": "Python", ".dart": "Dart", ".js": "JavaScript", ".ts": "TypeScript",
    ".jsx": "React", ".tsx": "React", ".vue": "Vue",
    ".swift": "Swift", ".kt": "Kotlin", ".java": "Java",
    ".rs": "Rust", ".go": "Go", ".rb": "Ruby", ".php": "PHP",
    ".c": "C", ".cpp": "C++", ".h": "C/C++", ".cs": "C#",
    ".sh": "Shell", ".ps1": "PowerShell", ".html": "HTML", ".css": "CSS",
}

IGNORE = {
    ".git", "node_modules", "__pycache__", ".venv", "venv", "env",
    ".idea", ".vscode", ".DS_Store", "build", "dist", ".next",
    ".dart_tool", ".pub-cache", ".flutter-plugins", "Pods", ".gradle", "target",
}


def git_add(filepath):
    """Stage a file for the current commit."""
    try:
        subprocess.run(["git", "add", str(filepath)], cwd=str(ROOT),
                       capture_output=True, timeout=10)
    except Exception:
        pass


def count_lines(filepath):
    try:
        return sum(1 for _ in open(filepath, "r", encoding="utf-8", errors="ignore"))
    except Exception:
        return 0


# ── 1. Scan stats ────────────────────────────────────────────────────────────

def scan():
    lang_count = {}
    total_files = 0
    total_code_lines = 0
    biggest = {"path": "", "lines": 0, "lang": ""}

    for root, dirs, files in os.walk(ROOT):
        dirs[:] = [d for d in dirs if d not in IGNORE]
        for f in files:
            fpath = Path(root) / f
            ext = fpath.suffix.lower()
            total_files += 1

            if ext in EXT_LANG:
                lines = count_lines(fpath)
                lang = EXT_LANG[ext]
                lang_count[lang] = lang_count.get(lang, 0) + lines
                total_code_lines += lines
                if lines > biggest["lines"]:
                    biggest = {"path": str(fpath.relative_to(ROOT)), "lines": lines, "lang": lang}

    if total_code_lines < 500:
        phase = "GRAINE"
    elif total_code_lines < 2000:
        phase = "GERMINATION"
    elif total_code_lines < 10000:
        phase = "CROISSANCE"
    else:
        phase = "CANOPEE"

    return {
        "repo": ROOT.name,
        "date": datetime.now().isoformat(),
        "phase": phase,
        "total_files": total_files,
        "total_code_lines": total_code_lines,
        "languages": lang_count,
        "biggest_file": biggest,
    }


# ── 2. Update winter-tree.json ──────────────────────────────────────────────

def update_project_tree(stats):
    """Met a jour data/topology/winter-tree.json avec les stats fraiches."""
    if not TREE_FILE.exists():
        return False

    try:
        with open(TREE_FILE, "r", encoding="utf-8") as f:
            tree = json.load(f)
    except (json.JSONDecodeError, IOError):
        return False

    py_lines = stats["languages"].get("Python", 0)
    html_lines = stats["languages"].get("HTML", 0)
    total_lines = py_lines + html_lines

    if py_lines < 500:
        phase = "GRAINE"
    elif py_lines < 5000:
        phase = "GERMINATION"
    elif py_lines < 20000:
        phase = "CROISSANCE"
    else:
        phase = "CANOPEE"

    tree["phase"] = phase
    tree["date"] = TODAY

    tree["stats"] = {
        "total_files": stats["total_files"],
        "total_code_lines": total_lines,
        "python_lines": py_lines,
        "html_lines": html_lines,
        "languages": stats["languages"],
        "biggest_file": stats["biggest_file"],
    }

    if "scale" in tree:
        tree["scale"]["lines"] = total_lines
        # Keep existing label prefix (may have emoji), just update numbers
        old_label = tree["scale"].get("label", "")
        prefix = old_label.split("(")[0].strip() if "(" in old_label else "Baobab"
        data_gb = tree["scale"].get("data_gb", "?")
        tree["scale"]["label"] = f"{prefix} ({py_lines // 1000}K Python + {html_lines // 1000}K HTML + {data_gb}GB data)"

    # Write as bytes to avoid Windows encoding issues with emojis
    raw = json.dumps(tree, indent=2, ensure_ascii=False)
    TREE_FILE.write_bytes(raw.encode("utf-8"))

    git_add(TREE_FILE)
    return True


# ── 3. Update docs dates ────────────────────────────────────────────────────

def update_doc_date(filepath, patterns):
    """
    Update date patterns in a markdown file.
    patterns = list of (regex, replacement_template) tuples.
    replacement_template can use {today} and {today_fr}.
    """
    if not filepath.exists():
        return False

    try:
        text = filepath.read_text(encoding="utf-8")
    except Exception:
        return False

    original = text
    for pattern, replacement in patterns:
        repl = replacement.format(today=TODAY, today_fr=TODAY_FR)
        text = re.sub(pattern, repl, text, count=1)

    if text != original:
        filepath.write_text(text, encoding="utf-8")
        git_add(filepath)
        return True
    return False


def update_changelog(stats):
    """Update CHANGELOG.md — no content changes, just ensure date header is current."""
    # Don't create content — just touch the file if it exists
    # The date in the most recent session header stays as-is (it's historical)
    # But we can update a machine-readable footer with stats
    if not CHANGELOG.exists():
        return False

    try:
        text = CHANGELOG.read_text(encoding="utf-8")
    except Exception:
        return False

    # Update or add stats footer
    footer = f"\n---\n_Auto-update: {TODAY} | {stats['languages'].get('Python', 0):,}L Python | {stats['total_files']:,} fichiers | phase {stats['phase']}_\n"

    # Replace existing footer or append
    footer_pattern = r'\n---\n_Auto-update:.*?\n'
    if re.search(footer_pattern, text):
        text = re.sub(footer_pattern, footer, text)
    else:
        text = text.rstrip() + footer

    CHANGELOG.write_text(text, encoding="utf-8")
    git_add(CHANGELOG)
    return True


def update_todo(stats):
    """Update TODO.md — date in header line."""
    py_lines = stats["languages"].get("Python", 0)
    return update_doc_date(TODO_FILE, [
        # > Dernière màj: 16 mars 2026 (session 27), Sky×Claude (Opus 4.6)
        (
            r'(> Dernière màj: )\d+ \w+ \d{4}',
            r'\g<1>{today_fr}'
        ),
    ])


def update_sol(stats):
    """Update SOL.md — date in header."""
    return update_doc_date(SOL_FILE, [
        # > Yggdrasil Engine — Versoix, 16 mars 2026
        (
            r'(> Yggdrasil Engine — Versoix, )\d+ \w+ \d{4}',
            r'\g<1>{today_fr}'
        ),
    ])


# ── Main ─────────────────────────────────────────────────────────────────────

def main():
    stats = scan()
    updated = []

    # 1. Cross-projets stats
    raw = json.dumps(stats, indent=2, ensure_ascii=False)
    STATS_FILE.write_bytes(raw.encode("utf-8"))
    git_add(STATS_FILE)

    # 2. winter-tree.json
    if update_project_tree(stats):
        updated.append("winter-tree.json")

    # 3. CHANGELOG.md
    if update_changelog(stats):
        updated.append("CHANGELOG.md")

    # 4. TODO.md
    if update_todo(stats):
        updated.append("TODO.md")

    # 5. SOL.md
    if update_sol(stats):
        updated.append("SOL.md")

    parts = f"{stats['total_code_lines']:,}L, phase {stats['phase']}"
    if updated:
        parts += f", auto-updated: {', '.join(updated)}"
    print(f"[winter-tree] OK {stats['repo']}: {parts}")


if __name__ == "__main__":
    main()
